# Copy to `.env` and fill in from your Supabase project (Project Settings > API).
# Then restart the bundler: npx expo start --clear
#
# Both values are safe to ship in the app bundle — the publishable/anon key
# grants nothing on its own. Row Level Security is what protects the data, and
# Postgres enforces it regardless of who holds this key.
#
# The SERVICE ROLE key is a different thing entirely. It bypasses RLS. It must
# never appear here, in the app, or in git.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Push notifications need an EAS project id (phase 6). Without one the Expo push
# service will not issue a token and every alert lands in-app only — which for
# "your bus is 5 minutes away" is the same as not sending it.
# EXPO_PUBLIC_EAS_PROJECT_ID=
